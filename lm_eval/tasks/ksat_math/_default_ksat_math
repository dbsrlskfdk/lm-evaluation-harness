dataset_path: Quadyun/Korean_SAT_MATH
test_split: test 
output_type:
doc_to_text: "{{question}}\n\n{% if choices %}{% for i in range(choices | length) %}{{i}}. {{choices[i]}}\n{% endfor %}{% endif %}"
doc_to_target: "{{answer}}"
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
filter_list:
  - name: "strict-match"
    filter:
      - function: "regex"
        regex_pattern: "oxed{(.*?)}"
      - function: "take_first"
metadata:
  version: 1.0
